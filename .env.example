# ─── OpenRouter AI ───────────────────────────────────────────────────────────
# Required for the AI Editorial Desk (editorial review, SEO generation, etc.)
# Obtain your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Copy these from your Supabase project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...          # anon/public key (safe to commit)
SUPABASE_PROJECT_ID=your-project-id

# Exposed to the Vite client bundle (same values as above)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
VITE_SUPABASE_PROJECT_ID=your-project-id

# ─── Admin bootstrap ──────────────────────────────────────────────────────────
# Optional: protects the one-time admin-init endpoint
ADMIN_INIT_SECRET=change-me
